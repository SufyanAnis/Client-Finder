# ---------- AI + search (required) ----------
# Groq (free): https://console.groq.com  -> API Keys
GROQ_API_KEY=
# Tavily (free web search, ~1,000 searches/month): https://tavily.com
TAVILY_API_KEY=
# Optional model overrides (defaults: openai/gpt-oss-120b, openai/gpt-oss-20b).
# Check what your key can use: https://console.groq.com/docs/models
# GROQ_MODEL=
# GROQ_FAST_MODEL=
# Paid alternative with native web search (no Tavily needed):
# ANTHROPIC_API_KEY=

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://findmyclients.vercel.app
# Shown on the contact/privacy pages if set
# NEXT_PUBLIC_CONTACT_EMAIL=
# Google Search Console "HTML tag" verification code (content="..." value only)
# NEXT_PUBLIC_GSC_VERIFICATION=

# ---------- Google AdSense ----------
# Publisher id. Setting it adds the AdSense script, the verification meta tag and /ads.txt.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# Optional manual ad units (Auto ads work with just the client id)
# NEXT_PUBLIC_AD_SLOT_IN_ARTICLE=
# NEXT_PUBLIC_AD_SLOT_DISPLAY=
# NEXT_PUBLIC_AD_SLOT_MULTIPLEX=

# ---------- Free-use limits ----------
# Upstash Redis (free) makes limits + cache shared across all serverless instances.
# Without it they're per-instance and only approximate. Vercel's Upstash integration sets these.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# FREE_SEARCHES_PER_DAY=3
# FREE_DRAFTS_PER_DAY=10
# FREE_LOOKUPS_PER_DAY=5
# Site-wide Tavily credits per day (a search uses 2-3, a contact lookup 1)
# GLOBAL_WEB_SEARCHES_PER_DAY=30
# GLOBAL_LLM_CALLS_PER_DAY=200

# ---------- Bot protection (optional, recommended) ----------
# Cloudflare Turnstile (free): https://dash.cloudflare.com -> Turnstile
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ---------- Owner login (unlimited use + contact inbox) ----------
AUTH_EMAIL=
AUTH_PASSWORD=
AUTH_SECRET=

# ---------- Contact form delivery ----------
# Email each message to you (free): https://web3forms.com
WEB3FORMS_ACCESS_KEY=
# Also save to the /inbox page (free Postgres): https://supabase.com — service role key, server-only
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
